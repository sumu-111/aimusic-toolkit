    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.0.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1"
  }
